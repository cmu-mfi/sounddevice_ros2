<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sounddevice_driver</name>
  <version>0.0.0</version>
  <description>ROS 2 microphone capture driver using Python sounddevice.</description>
  <maintainer email="alexander@minor.pw">Alexander Minor</maintainer>
  <license>Apache License 2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>foxglove_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-sounddevice-pip</exec_depend>
  <exec_depend>portaudio19-dev</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
